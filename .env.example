# Copy to .env.local and fill in. Never commit real values.

# --- Rate limiting (lib/rateLimit.ts) ---
# Shared counter for the limiter. Optional: when both are unset the limiter
# falls back to the `rate_limits` Postgres table, which still enforces across
# instances but costs a database round trip per metered request.
# From the Upstash console: Redis database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection (lib/turnstile.ts) ---
# Cloudflare Turnstile, guarding the public attestation confirmation form.
# Both are optional: with the secret unset the server skips the bot check and
# the route is protected only by its rate limit. With the site key unset the
# form renders without the widget, which is the local development path.
# Set BOTH in production, or neither.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
